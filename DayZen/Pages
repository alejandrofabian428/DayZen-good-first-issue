        <!-- Confirm Password -->
        <div class="field">
            <label for="confirmPassword">Confirm Password</label>
            <div class="input-wrap">
                <input type="password" id="confirmPassword" name="confirmPassword"
                       placeholder="Repeat your password" required>
                <button type="button" class="toggle-pw" id="togglePw2" aria-label="Show confirm password">
                    <span id="eyeIcon2">&#128065;</span>
                </button>
            </div>
            <div class="field-hint" id="hint-confirm"></div>
        </div>

        <button type="submit" id="registerBtn" disabled>Create account</button>

    </form>

    <div class="divider"><span>or continue with</span></div>

    <div class="social-buttons">
        <button class="social-btn" type="button" onclick="alert('Google OAuth coming soon!')">
