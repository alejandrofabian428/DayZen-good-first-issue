            position: absolute; right: 13px; top: 50%; transform: translateY(-50%);
            font-size: 16px; pointer-events: none;
        }

        .field-hint { font-size: 11px; min-height: 16px; margin-top: 5px; color: #e53e3e; }
        .field-hint.ok { color: #38a169; }

        /* Password strength bars */
        .pw-strength { display: flex; gap: 4px; margin-top: 7px; }
        .pw-bar { height: 3px; flex: 1; background: #e2e8f0; border-radius: 2px; transition: background 0.35s; }

        /* Strength label */
        .pw-strength-label {
            font-size: 11px; margin-top: 4px; color: #7a8494;
            min-height: 14px; transition: color 0.3s;
        }

        /* Error box */
        .error-box {
            background: #fff5f5; border: 1px solid #fed7d7;
            border-radius: 8px; padding: 10px 14px;
            font-size: 13px; color: #c53030;
            margin-bottom: 1rem; display: none;
        }

        #registerBtn {
            width: 100%; background: #2891b7; color: #fff;
            border: none; border-radius: 8px;
            font-family: 'Outfit', sans-serif; font-size: 15px; font-weight: 600;
            padding: 12px; cursor: pointer; margin-top: 0.5rem;
            transition: background 0.2s, transform 0.1s, box-shadow 0.2s;
            box-shadow: 0 2px 8px rgba(40,145,183,0.35);
        }
        #registerBtn:hover:not(:disabled) { background: #1e7aa0; box-shadow: 0 4px 14px rgba(40,145,183,0.45); }
        #registerBtn:active:not(:disabled) { transform: scale(0.98); }
        #registerBtn:disabled { background: #a8dadc; color: #fff; cursor: not-allowed; box-shadow: none; }

        .divider { display: flex; align-items: center; gap: 12px; margin: 1.25rem 0; }
        .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #e2e8f0; }
        .divider span { font-size: 12px; color: #b0bac6; white-space: nowrap; }

        .social-buttons { display: flex; flex-direction: column; gap: 10px; }
        .social-btn {
            width: 100%; background: #fff; border: 1.5px solid #e2e8f0; border-radius: 8px;
            color: #1a1a2e; font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 500;
            padding: 10px 14px; cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 10px;
            transition: background 0.18s, border-color 0.18s, transform 0.1s;
        }
        .social-btn:hover { background: #f7f9fc; border-color: #2891b7; }
        .social-btn:active { transform: scale(0.98); }

        .login-link { text-align: center; font-size: 13px; color: #7a8494; margin-top: 1.25rem; }
        .login-link a { color: #2891b7; text-decoration: none; font-weight: 600; }
        .login-link a:hover { text-decoration: underline; }

        @media (max-width: 480px) {
            .container { padding: 2rem 1.25rem; }
            .welcome-message { font-size: 20px; }
        }
    </style>
</head>
<body>
<div class="container">

    <div class="logo">
        <img src="../assets/images/logos/logo.png" alt="DayZen Logo">
