            Continue with Facebook
        </button>
    </div>

    <p class="login-link">Already have an account? <a href="Register.html">Sign in</a></p>

</div>

<script>
    const usernameEl  = document.getElementById('username');
    const emailEl     = document.getElementById('email');
    const passwordEl  = document.getElementById('password');
    const confirmEl   = document.getElementById('confirmPassword');
    const registerBtn = document.getElementById('registerBtn');
    const errorBox    = document.getElementById('errorBox');
    const bars        = ['bar1','bar2','bar3','bar4'].map(id => document.getElementById(id));
    const strengthLbl = document.getElementById('strengthLabel');

    const state = { username: false, email: false, password: false, confirm: false };

    function showError(msg) { errorBox.textContent = msg; errorBox.style.display = 'block'; }
    function hideError()    { errorBox.style.display = 'none'; }

    function setField(name, inputEl, isValid, errorMsg, okMsg) {
        const hint = document.getElementById('hint-' + name);
        inputEl.classList.toggle('valid',   isValid);
        inputEl.classList.toggle('invalid', !isValid && inputEl.value.length > 0);
        if (!isValid && inputEl.value.length > 0) {
            hint.textContent = errorMsg;
            hint.className = 'field-hint';
        } else if (isValid) {
            hint.textContent = okMsg || '';
            hint.className = 'field-hint ok';
        } else {
            hint.textContent = '';
            hint.className = 'field-hint';
        }
        state[name] = isValid;
        registerBtn.disabled = !(state.username && state.email && state.password && state.confirm);
    }

    // --- Username ---
    usernameEl.addEventListener('input', () => {
        hideError();
        const v = usernameEl.value.trim();
        if (!v.length) { setField('username', usernameEl, false, ''); return; }
        const valid = /^[a-zA-Z0-9_]{3,30}$/.test(v);
        setField('username', usernameEl, valid,
            v.length < 3 ? 'At least 3 characters' : 'Only letters, numbers and _',
            'Valid username');
    });

    // --- Email ---
    emailEl.addEventListener('input', () => {
        hideError();
        const v = emailEl.value.trim();
        if (!v.length) { setField('email', emailEl, false, ''); return; }
        const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
        setField('email', emailEl, valid, 'Enter a valid email address', 'Valid email');
    });

    // --- Password strength ---
    function pwScore(pw) {
        let s = 0;
        if (pw.length >= 8)          s++;
        if (/[A-Z]/.test(pw))        s++;
        if (/[0-9]/.test(pw))        s++;
        if (/[^A-Za-z0-9]/.test(pw)) s++;
        return s;
    }

    passwordEl.addEventListener('input', () => {
        hideError();
        const pw    = passwordEl.value;
        const score = pwScore(pw);
        const barColors   = ['#e53e3e', '#e53e3e', '#d97706', '#38a169'];
        const labelTexts  = ['', 'Too weak', 'Weak', 'Good', 'Strong'];
        const labelColors = ['', '#e53e3e', '#d97706', '#2891b7', '#38a169'];

        bars.forEach((b, i) => { b.style.background = i < score ? barColors[score - 1] : '#e2e8f0'; });

        strengthLbl.textContent = pw.length ? labelTexts[score] : '';
        strengthLbl.style.color = labelColors[score] || '#7a8494';

        const isValid = pw.length >= 8 && score >= 2;
        if (!pw.length)        setField('password', passwordEl, false, '');
        else if (pw.length < 8) setField('password', passwordEl, false, 'At least 8 characters required');
        else setField('password', passwordEl, isValid,
            'Add uppercase letters, numbers or symbols', '');

        // Re-validar confirmación si ya tiene algo escrito
        if (confirmEl.value.length > 0) validateConfirm();
    });

    // --- Confirm password ---
    function validateConfirm() {
        const match = confirmEl.value === passwordEl.value && confirmEl.value.length > 0;
        const mismatch = confirmEl.value.length > 0 && confirmEl.value !== passwordEl.value;

        confirmEl.classList.toggle('valid',   match);
        confirmEl.classList.toggle('invalid', mismatch);

        const hint = document.getElementById('hint-confirm');
        if (match) {
            hint.textContent = 'Passwords match';
            hint.className   = 'field-hint ok';
        } else if (mismatch) {
            hint.textContent = 'Passwords do not match';
            hint.className   = 'field-hint';
        } else {
            hint.textContent = '';
            hint.className   = 'field-hint';
        }
        state.confirm = match;
        registerBtn.disabled = !(state.username && state.email && state.password && state.confirm);
    }

    confirmEl.addEventListener('input', validateConfirm);

    // --- Toggle password visibility ---
    document.getElementById('togglePw1').addEventListener('click', () => {
        const show = passwordEl.type === 'password';
        passwordEl.type = show ? 'text' : 'password';
        document.getElementById('eyeIcon1').textContent = show ? '\uD83D\uDE48' : '\uD83D\uDC41';
    });

    document.getElementById('togglePw2').addEventListener('click', () => {
        const show = confirmEl.type === 'password';
        confirmEl.type = show ? 'text' : 'password';
        document.getElementById('eyeIcon2').textContent = show ? '\uD83D\uDE48' : '\uD83D\uDC41';
    });

    // --- Submit ---
    document.getElementById('registerForm').addEventListener('submit', e => {
        e.preventDefault();
        hideError();

        const username = usernameEl.value.trim();
        const email    = emailEl.value.trim();
        const password = passwordEl.value;

        // Verificar si ya existe
        const users = JSON.parse(localStorage.getItem('dayzen_users') || '[]');
        const takenUsername = users.find(u => u.username === username);
        const takenEmail    = users.find(u => u.email === email);

        if (takenUsername) { showError('This username is already taken. Try another one.'); return; }
        if (takenEmail)    { showError('An account with this email already exists. Try signing in.'); return; }

        // Guardar usuario — el identifier para el login es el username
        users.push({ identifier: username, username, email, password });
        localStorage.setItem('dayzen_users', JSON.stringify(users));

        // Sesión activa
        localStorage.setItem('username', username);
        localStorage.setItem('dayzen_logged', 'true');

        registerBtn.textContent = 'Account created! Redirecting...';
        registerBtn.disabled = true;

        setTimeout(() => {
            window.location.href = 'indexacc.html';
        }, 1200);
    });
</script>
</body>
</html>

